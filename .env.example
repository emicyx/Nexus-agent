# LLM 配置
QWEN_API_KEY=sk-xxx
BAIDU_API_KEY=xxx
LLM_MODEL=qwen-plus
LLM_REGION=cn
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=600

# 服务配置
CORS_ORIGINS=["http://localhost:3000"]

# API 鉴权（P0-2/P0-4）：设置后所有 /v1/* 接口要求 X-API-Key。
# 前端经 Next 服务端同源代理（/v1/[...path]）注入密钥——浏览器 bundle 不含密钥，
# 无需也不能再配 NEXT_PUBLIC_API_KEY。
# 生产（APP_ENV=production）下留空会直接拒绝启动；本地开发留空可运行（有告警）。
# APP_API_KEY=change-me-to-a-long-random-string

# 前端访问密码门（P0-4 配套）：设置后浏览器访问需先在 /login 登录，
# 通过后签发 HttpOnly 会话 Cookie（7 天）。留空 = 无登录门（本地开发）。
# 生产部署建议设置，与 APP_API_KEY 用不同的值。
# APP_ACCESS_PASSWORD=another-long-random-string

# ── P0-5 限流 ──
# 每分钟每调用方（X-API-Key 或 IP）最大对话请求数；0 = 不限
# CHAT_RATE_LIMIT_PER_MIN=20
# 并发 SSE 运行上限（每请求一个 Crew + 线程 + 队列）；0 = 不限
# MAX_CONCURRENT_RUNS=8

# ── SSRF / 文档端点 ──
# 内网网段白名单（精确放行，替代全局粗放行）：如需抓取内网页面时配置
# SSRF_EXTRA_ALLOW_CIDRS=["10.0.1.0/24"]
# API 文档端点（/docs 等）：不设 = dev 开、其余环境关
# DOCS_ENABLED=false

# 数据库口令（P0-4）：compose 用它注入 postgres 与后端 DSN，强烈建议修改默认值
# POSTGRES_PASSWORD=nexus

# 应用数据库账号（非 superuser，init.sh 首次初始化时创建；密码勿含单引号）
# 存量数据卷需按 README「存量数据卷补建应用账号」手工执行 SQL，
# 或临时设 APP_DB_USER=nexus 回退到 superuser 账号
# APP_DB_USER=nexus_app
# APP_DB_PASSWORD=nexus_app

# Redis 可选密码（P1-3b）：设置后 redis 启用 requirepass，同时必须整体覆盖 REDIS_URL
# REDIS_PASSWORD=my-redis-secret
# REDIS_URL=redis://:my-redis-secret@localhost:6379/0

# 文件工具沙箱（P0-1）：读写限制在 SANDBOX_DATA_DIR 内，默认即可
# SANDBOX_DATA_DIR=/app/data
# SANDBOX_EXTRA_READ_DIRS=[]

# SSRF 防护（P0-3）：默认拒绝私网/环回地址；内网部署需抓内网页面时设 true
# SSRF_ALLOW_PRIVATE_NETWORK=false

# 基础设施（Docker Compose 已配置默认值，本地开发可不设）
# POSTGRES_DSN=postgresql://nexus:nexus@localhost:5432/nexus
# REDIS_URL=redis://localhost:6379/0

# Embedding 配置（Week 4 RAG，复用 QWEN_API_KEY）
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ── 上线加固（欠账清单修复，2026-08-21）────────────────────────────
# 运行环境：production 下建表失败直接终止启动（避免空库接流量）
# APP_ENV=dev

# 建表严格模式：true=无条件 fail-fast；false=无条件宽容；不设=按 APP_ENV 推断
# DB_INIT_STRICT=

# 种子演示数据：默认 false（生产安全方向）；本地开发想要开箱即用的演示
# Agent/工具时设 true
# SEED_DEMO_DATA=false

# SSE 事件队列上限（慢客户端背压保护，满时丢最旧事件）
# SSE_QUEUE_MAXSIZE=200

# Token 日预算（prompt+completion 合计，跨会话累计，Redis 持久）。
# 0=不限；超限拒绝新请求并返回 budget_exceeded 提示
# LLM_TOKEN_DAILY_BUDGET=0

# 上下文窗口逃生口：>0 时覆盖按模型名查表的值（防查表过时误导 CrewAI 裁剪）
# LLM_CONTEXT_WINDOW_OVERRIDE=0

# 沙箱产物清理：outputs/screenshots 超过保留天数的文件每日清理 + 磁盘告警
# SANDBOX_RETENTION_DAYS=7
# SANDBOX_CLEANUP_INTERVAL_HOURS=24
# DISK_USAGE_WARN_PCT=85

# 优雅停机：停止接新会话后给在跑 Crew 的收尾窗口（秒）
# SHUTDOWN_GRACE_SECONDS=60

# ── S1 QQ 渠道（OneBot 11 反向 WS / NapCat）──────────────────────────
# WS 鉴权 token：NapCat WebUI 反向 WS 地址 ws://backend:8000/v1/channels/onebot/ws?token=<同值>
# 必须配置（未配置时 WS endpoint 拒绝一切连接，QQ 通道关闭）。生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
ONEBOT_WS_TOKEN=
# owner 白名单：逗号分隔 QQ 号（你自己的 QQ）。名单外入站消息记 WARNING 并静默不回
QQ_OWNER_IDS=
# 机器人自身 QQ 号：群消息 @ 匹配用（NapCat 登录的账号；私聊不依赖它）
QQ_BOT_SELF_ID=

# ── S2 定时任务与推送（巡检告警 + KB 日报）──────────────────────────
# 主动推送目标（egress 唯一目标来源，安全不变量 1；建议私聊直达）：
# {"type":"private","user_id":123456} 或 {"type":"group","group_id":789}
QQ_ALERT_TARGET=
# 巡检目标清单（JSON 数组，2-5 个真实 URL，至少一个公网站点做对照）。
# http_check 只查这里的目标（模型不可指定 URL）；私网/内网目标由运维在此显式声明
# MONITOR_TARGETS=[{"name":"backend","url":"http://backend:8000/health","expect_status":200,"timeout_s":10},{"name":"frontend","url":"http://frontend:3000","expect_status":200,"timeout_s":10},{"name":"example","url":"https://www.example.com","expect_status":200,"timeout_s":10}]
MONITOR_TARGETS=[]
# cron 时区（安全不变量 9：cron 一律显式时区）
JOB_TIMEZONE=Asia/Shanghai
# eval 全局开关（§5.6 零外发第二道闸）：true = 一切 job 推送强制抑制（记 suppressed(eval)）
NEXUS_EVAL_MODE=false
# 调度总开关（回滚）：false = 不注册任何定时任务
JOBS_ENABLED=true
