# LLM 配置
QWEN_API_KEY=sk-xxx
BAIDU_API_KEY=xxx
LLM_MODEL=qwen-plus
LLM_REGION=cn
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=600

# 服务配置
CORS_ORIGINS=["http://localhost:3000"]

# 基础设施（Docker Compose 已配置默认值，本地开发可不设）
# POSTGRES_DSN=postgresql://nexus:nexus@localhost:5432/nexus
# REDIS_URL=redis://localhost:6379/0

# Embedding 配置（Week 4 RAG，复用 QWEN_API_KEY）
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
